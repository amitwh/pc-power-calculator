# Hostinger (LiteSpeed) serves this build as static files from public_html.
#
# The prerenderer writes dist/<route>/index.html, so every route is a real
# directory on disk. LiteSpeed's default DirectorySlash behaviour answers a
# request for /guides with a 301 to /guides/ — but the canonical tags, the
# sitemap and the report's re-import link all name the slash-less form, so
# every one of those URLs would be a redirect.
#
# nginx has the same problem and the same fix, in nginx/default.conf:
# `absolute_redirect off` plus a try_files order that serves the index file
# directly. This is the Apache/LiteSpeed equivalent:
#
#   DirectorySlash Off  — serve /guides as /guides/index.html, no redirect.
#   the rewrite rules  — serve a route's index.html directly, and send
#                         anything that is not a file on disk (a share link
#                         like /build/<token>) to the SPA shell, which is what
#                         the nginx `try_files ... /index.html` does.
#
# The Coolify deployment ignores this file (nginx never reads .htaccess) and
# enforces the same policy itself. Keep the two in sync.
#
# Every directive below is guarded so that a host without mod_rewrite, or one
# that rejects .htaccess outright, degrades to the current behaviour instead
# of taking the site down.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A prerendered route: serve its index.html without a redirect.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Not a file on disk (e.g. /build/<share token>): hand it to the SPA.
  # /api/ is excluded on purpose: an API path that does not exist here must
  # 404, not answer with the app shell, or a client that only reads the
  # status code would believe a message had been sent.
  #
  # So is any path whose last segment has a file extension: that is a request
  # for a file, and a file that is not there must 404. A script that answers
  # with the HTML of a page and a 200 fails silently in the browser — no
  # error, just a part of the app that stops working. Only a path that could
  # be a client-side route falls back to the shell, and a route has no file
  # extension.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Security headers ---
#
# The same policy nginx/default.conf sets on the Coolify deployment, and the
# same one server/hostinger.mjs sets when the Node process is the one serving
# the files. Whichever layer answers a request, the visitor gets the same
# headers. Keep all three in sync.
#
# `frame-ancestors 'none'` is the whole of the clickjacking defence; there is
# no separate X-Frame-Options header, so the two cannot disagree.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' data: https://www.googletagmanager.com https://ipapi.co https://ipwho.is https://ip-api.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://fundingchoicesmessages.google.com https://*.doubleclick.net; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net; manifest-src 'self'; worker-src 'self' blob:; frame-src 'self' https://*.googlesyndication.com https://googleads.g.doubleclick.net; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # A prerendered page must be revalidated on every visit. Without an explicit
  # directive a browser applies HEURISTIC freshness — 10% of the time since
  # the file was last modified — so a page last touched weeks ago could be
  # served for days, and a deploy could stay invisible for hours.
  Header always set Cache-Control "no-cache"

  # The built bundles carry a content hash in their name, so they can be
  # cached briefly. sw.js is excluded on purpose: a cached service worker
  # never updates itself, and the app would be stuck on an old build.
  <FilesMatch "^(?!sw\.js$)(?!manifest\.webmanifest$).*\.(js|css|woff2|ttf|png|jpe?g|svg|ico|webp|map)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
